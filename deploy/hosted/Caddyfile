serenity.sire.run {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "same-origin"
    }
    reverse_proxy 127.0.0.1:8090 {
        # Replace any caller-supplied header with the actual client address.
        header_up X-Serenity-Client-IP {remote_host}
    }
}

app.serenity.sire.run {
    @home path /
    redir @home https://serenity.sire.run/dashboard 308
    redir https://serenity.sire.run{uri} 308
}
