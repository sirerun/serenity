serenity.sire.run {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "same-origin"
    }
    reverse_proxy 127.0.0.1:8090 {
        # Replace any caller-supplied header with the actual client address.
        header_up X-Serenity-Client-IP {remote_host}
    }
}
