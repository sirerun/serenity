          }
        },
        {
          "method": "GET",
          "path": "/disposition/subscribe?cursor=0",
          "response": {
            "status": 200,
            "body": "{\"events\":[{\"cursor\":1,\"kind\":\"disposition.item_created\",\"payload\":{\"item_id\":\"e5f390a16248762d57ea0db06240e23d\",\"kind\":\"distill\",\"state\":\"pending\"},\"occurred_at\":\"2026-09-08T18:16:48.251546Z\"}]}\n"
          }
        }
      ]
    },
