{
  "protocol": "disposition",
  "operation": "list_pending",
  "cases": [
    {
      "name": "list_pending filters by kind: only the reconcile item is returned",
      "steps": [
        {
          "method": "POST",
          "path": "/disposition/list_pending",
          "request_body": {
            "kinds": [
              "reconcile"
            ]
          },
          "response": {
            "status": 200,
            "body": "{\"items\":[{\"item\":{\"id\":\"739a6edff1b55109115fa856fd5894f7\",\"kind\":\"reconcile\",\"state\":\"pending\",\"payload\":{},\"created_at\":\"2026-09-07T12:00:01Z\",\"updated_at\":\"2026-09-07T12:00:01Z\"}}]}\n"
          }
        }
      ]
    },
    {
      "name": "list_pending with group:true collapses items sharing a group_id into one row",
      "steps": [
        {
          "method": "POST",
          "path": "/disposition/list_pending",
          "request_body": {
            "group": true
          },
          "response": {
            "status": 200,
            "body": "{\"items\":[{\"item\":{\"id\":\"70a5fffb9988e68088a3e4104f151499\",\"kind\":\"decompose\",\"state\":\"pending\",\"group_id\":\"g1\",\"payload\":{},\"created_at\":\"2026-09-07T12:00:00Z\",\"updated_at\":\"2026-09-07T12:00:00Z\"},\"members\":[{\"id\":\"70a5fffb9988e68088a3e4104f151499\",\"kind\":\"decompose\",\"state\":\"pending\",\"group_id\":\"g1\",\"payload\":{},\"created_at\":\"2026-09-07T12:00:00Z\",\"updated_at\":\"2026-09-07T12:00:00Z\"},{\"id\":\"129473f0e84a834898947445899e1112\",\"kind\":\"decompose\",\"state\":\"pending\",\"group_id\":\"g1\",\"payload\":{},\"created_at\":\"2026-09-07T12:00:01Z\",\"updated_at\":\"2026-09-07T12:00:01Z\"}]},{\"item\":{\"id\":\"f0228b0579657b3ede67e502ff5bf32f\",\"kind\":\"distill\",\"state\":\"pending\",\"payload\":{},\"created_at\":\"2026-09-07T12:00:02Z\",\"updated_at\":\"2026-09-07T12:00:02Z\"}}]}\n"
          }
        }
      ]
    },
    {
      "name": "parked items appear only with the parked filter; the default view excludes them",
      "steps": [
        {
          "method": "POST",
          "path": "/disposition/list_pending",
          "request_body": {},
          "response": {
            "status": 200,
            "body": "{\"items\":[{\"item\":{\"id\":\"9db0922e742781a9efa22f04733a122d\",\"kind\":\"distill\",\"state\":\"pending\",\"payload\":{},\"created_at\":\"2026-10-22T12:00:00Z\",\"updated_at\":\"2026-10-22T12:00:00Z\"}}]}\n"
          }
        },
        {
          "method": "POST",
          "path": "/disposition/list_pending",
          "request_body": {
            "parked": true
          },
          "response": {
            "status": 200,
            "body": "{\"items\":[{\"item\":{\"id\":\"fa972c0a4b736ba1d3660fd27bf6911f\",\"kind\":\"distill\",\"state\":\"parked\",\"payload\":{},\"created_at\":\"2026-09-07T12:00:00Z\",\"updated_at\":\"2026-10-22T12:00:00Z\",\"defer_count\":3}}]}\n"
          }
        }
      ]
    },
    {
      "name": "cursor pagination walks all 5 items in pages of 2 and terminates with no next_cursor",
      "steps": [
        {
          "method": "POST",
          "path": "/disposition/list_pending",
          "request_body": {
            "limit": 2
          },
          "response": {
            "status": 200,
            "body": "{\"items\":[{\"item\":{\"id\":\"8c8752457a4612e0da602412980c80c7\",\"kind\":\"distill\",\"state\":\"pending\",\"payload\":{\"n\":0},\"created_at\":\"2026-09-07T12:00:00Z\",\"updated_at\":\"2026-09-07T12:00:00Z\"}},{\"item\":{\"id\":\"5be764827e9b4353fbaa367fc5d4df36\",\"kind\":\"distill\",\"state\":\"pending\",\"payload\":{\"n\":1},\"created_at\":\"2026-09-07T12:00:01Z\",\"updated_at\":\"2026-09-07T12:00:01Z\"}}],\"next_cursor\":\"2\"}\n"
          }
        },
        {
          "method": "POST",
          "path": "/disposition/list_pending",
          "request_body": {
            "cursor": "2",
            "limit": 2
          },
          "response": {
            "status": 200,
            "body": "{\"items\":[{\"item\":{\"id\":\"49a04952bd89803827e903b08c599b6f\",\"kind\":\"distill\",\"state\":\"pending\",\"payload\":{\"n\":2},\"created_at\":\"2026-09-07T12:00:02Z\",\"updated_at\":\"2026-09-07T12:00:02Z\"}},{\"item\":{\"id\":\"0bf33da2f3f4025620eb925217b0fe54\",\"kind\":\"distill\",\"state\":\"pending\",\"payload\":{\"n\":3},\"created_at\":\"2026-09-07T12:00:03Z\",\"updated_at\":\"2026-09-07T12:00:03Z\"}}],\"next_cursor\":\"4\"}\n"
          }
        },
        {
          "method": "POST",
          "path": "/disposition/list_pending",
          "request_body": {
            "cursor": "4",
            "limit": 2
          },
          "response": {
            "status": 200,
            "body": "{\"items\":[{\"item\":{\"id\":\"a82f47c1da97e0b153720518b274852d\",\"kind\":\"distill\",\"state\":\"pending\",\"payload\":{\"n\":4},\"created_at\":\"2026-09-07T12:00:04Z\",\"updated_at\":\"2026-09-07T12:00:04Z\"}}]}\n"
          }
        }
      ]
    }
  ]
}
