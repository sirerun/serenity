{
  "protocol": "disposition",
  "operation": "dispose",
  "cases": [
    {
      "name": "dispose accept records the verdict",
      "steps": [
        {
          "method": "POST",
          "path": "/disposition/dispose",
          "request_body": {
            "item_id": "cda08aff5a5749c7f6ad9b50d90554ac",
            "verdict": "accept",
            "idempotency_key": "accept-key-1",
            "actor": "tester"
          },
          "response": {
            "status": 200,
            "body": "{\"results\":[{\"item\":{\"id\":\"cda08aff5a5749c7f6ad9b50d90554ac\",\"kind\":\"distill\",\"state\":\"disposed\",\"payload\":{},\"created_at\":\"2026-09-07T12:00:00Z\",\"updated_at\":\"2026-09-07T12:00:00Z\",\"verdict\":\"accept\",\"actor\":\"tester\",\"disposed_at\":\"2026-09-07T12:00:00Z\",\"idempotency_key\":\"accept-key-1\"}}]}\n"
          }
        }
      ]
    },
    {
      "name": "reject without a note returns the reject_requires_note protocol error",
      "steps": [
        {
          "method": "POST",
          "path": "/disposition/dispose",
          "request_body": {
            "item_id": "0a13575759c2272ce8f7959b6b7f215e",
            "verdict": "reject",
            "idempotency_key": "reject-key-1"
          },
          "response": {
            "status": 400,
            "body": "{\"error\":\"reject_requires_note\",\"message\":\"disposition: reject requires a note\"}\n"
          }
        }
      ]
    },
    {
      "name": "dispose without idempotency_key returns invalid_request",
      "steps": [
        {
          "method": "POST",
          "path": "/disposition/dispose",
          "request_body": {
            "item_id": "46f2b88c3b64599c78f7a0666d6c5e63",
            "verdict": "accept",
            "idempotency_key": ""
          },
          "response": {
            "status": 400,
            "body": "{\"error\":\"invalid_request\",\"message\":\"idempotency_key is required\"}\n"
          }
        }
      ]
    },
    {
      "name": "replaying dispose with the same idempotency_key returns replayed:true, never a second write",
      "steps": [
        {
          "method": "POST",
          "path": "/disposition/dispose",
          "request_body": {
            "item_id": "d0d31506c9a304c9e3c81664795dc521",
            "verdict": "accept",
            "idempotency_key": "replay-key-1",
            "actor": "tester"
          },
          "response": {
            "status": 200,
            "body": "{\"results\":[{\"item\":{\"id\":\"d0d31506c9a304c9e3c81664795dc521\",\"kind\":\"distill\",\"state\":\"disposed\",\"payload\":{},\"created_at\":\"2026-09-07T12:00:00Z\",\"updated_at\":\"2026-09-07T12:00:00Z\",\"verdict\":\"accept\",\"actor\":\"tester\",\"disposed_at\":\"2026-09-07T12:00:00Z\",\"idempotency_key\":\"replay-key-1\"}}]}\n"
          }
        },
        {
          "method": "POST",
          "path": "/disposition/dispose",
          "request_body": {
            "item_id": "d0d31506c9a304c9e3c81664795dc521",
            "verdict": "accept",
            "idempotency_key": "replay-key-1",
            "actor": "tester"
          },
          "response": {
            "status": 200,
            "body": "{\"results\":[{\"item\":{\"id\":\"d0d31506c9a304c9e3c81664795dc521\",\"kind\":\"distill\",\"state\":\"disposed\",\"payload\":{},\"created_at\":\"2026-09-07T12:00:00Z\",\"updated_at\":\"2026-09-07T12:00:00Z\",\"verdict\":\"accept\",\"actor\":\"tester\",\"disposed_at\":\"2026-09-07T12:00:00Z\",\"idempotency_key\":\"replay-key-1\"},\"replayed\":true}]}\n"
          }
        }
      ]
    },
    {
      "name": "dispose by group_id disposes every member individually, one result per member",
      "steps": [
        {
          "method": "POST",
          "path": "/disposition/dispose",
          "request_body": {
            "group_id": "g2",
            "verdict": "accept",
            "idempotency_key": "group-key-1"
          },
          "response": {
            "status": 200,
            "body": "{\"results\":[{\"item\":{\"id\":\"bf87faff5713ba6f5fe5e9b624356cbb\",\"kind\":\"decompose\",\"state\":\"disposed\",\"group_id\":\"g2\",\"payload\":{},\"created_at\":\"2026-09-07T12:00:00Z\",\"updated_at\":\"2026-09-07T12:00:00Z\",\"verdict\":\"accept\",\"disposed_at\":\"2026-09-07T12:00:00Z\",\"idempotency_key\":\"group-key-1\"}},{\"item\":{\"id\":\"c07701dc57cb9777ab687f8942c10c09\",\"kind\":\"decompose\",\"state\":\"disposed\",\"group_id\":\"g2\",\"payload\":{},\"created_at\":\"2026-09-07T12:00:01Z\",\"updated_at\":\"2026-09-07T12:00:00Z\",\"verdict\":\"accept\",\"disposed_at\":\"2026-09-07T12:00:00Z\",\"idempotency_key\":\"group-key-1\"}}]}\n"
          }
        }
      ]
    },
    {
      "name": "dispose by an unknown group_id returns not_found",
      "steps": [
        {
          "method": "POST",
          "path": "/disposition/dispose",
          "request_body": {
            "group_id": "no-such-group",
            "verdict": "accept",
            "idempotency_key": "group-key-2"
          },
          "response": {
            "status": 404,
            "body": "{\"error\":\"not_found\",\"message\":\"no items found for group_id no-such-group\"}\n"
          }
        }
      ]
    }
  ]
}
