{
  "protocol": "disposition",
  "operation": "dispose",
  "cases": [
    {
      "name": "dispose accept records the verdict",
      "steps": [
        {
          "method": "POST",
          "path": "/disposition/dispose",
          "request_body": {
            "item_id": "6bdc48ad531356f7c371d9a167cfac9c",
            "verdict": "accept",
            "idempotency_key": "accept-key-1",
            "actor": "tester"
          },
          "response": {
            "status": 200,
            "body": "{\"results\":[{\"item\":{\"id\":\"6bdc48ad531356f7c371d9a167cfac9c\",\"kind\":\"distill\",\"state\":\"disposed\",\"payload\":{},\"created_at\":\"2026-09-07T12:00:00Z\",\"updated_at\":\"2026-09-07T12:00:00Z\",\"verdict\":\"accept\",\"actor\":\"tester\",\"disposed_at\":\"2026-09-07T12:00:00Z\",\"idempotency_key\":\"accept-key-1\"}}]}\n"
          }
        }
      ]
    },
    {
      "name": "reject without a note returns the reject_requires_note protocol error",
      "steps": [
        {
          "method": "POST",
          "path": "/disposition/dispose",
          "request_body": {
            "item_id": "cf1f6b680b141ae8944d3841700fbc70",
            "verdict": "reject",
            "idempotency_key": "reject-key-1"
          },
          "response": {
            "status": 400,
            "body": "{\"error\":\"reject_requires_note\",\"message\":\"disposition: reject requires a note\"}\n"
          }
        }
      ]
    },
    {
      "name": "dispose without idempotency_key returns invalid_request",
      "steps": [
        {
          "method": "POST",
          "path": "/disposition/dispose",
          "request_body": {
            "item_id": "311d0e3bdfc3770510ab478d1707efa1",
            "verdict": "accept",
            "idempotency_key": ""
          },
          "response": {
            "status": 400,
            "body": "{\"error\":\"invalid_request\",\"message\":\"idempotency_key is required\"}\n"
          }
        }
      ]
    },
    {
      "name": "replaying dispose with the same idempotency_key returns replayed:true, never a second write",
      "steps": [
        {
          "method": "POST",
          "path": "/disposition/dispose",
          "request_body": {
            "item_id": "d62ea2ad57d0c4900c55d8fef87798a2",
            "verdict": "accept",
            "idempotency_key": "replay-key-1",
            "actor": "tester"
          },
          "response": {
            "status": 200,
            "body": "{\"results\":[{\"item\":{\"id\":\"d62ea2ad57d0c4900c55d8fef87798a2\",\"kind\":\"distill\",\"state\":\"disposed\",\"payload\":{},\"created_at\":\"2026-09-07T12:00:00Z\",\"updated_at\":\"2026-09-07T12:00:00Z\",\"verdict\":\"accept\",\"actor\":\"tester\",\"disposed_at\":\"2026-09-07T12:00:00Z\",\"idempotency_key\":\"replay-key-1\"}}]}\n"
          }
        },
        {
          "method": "POST",
          "path": "/disposition/dispose",
          "request_body": {
            "item_id": "d62ea2ad57d0c4900c55d8fef87798a2",
            "verdict": "accept",
            "idempotency_key": "replay-key-1",
            "actor": "tester"
          },
          "response": {
            "status": 200,
            "body": "{\"results\":[{\"item\":{\"id\":\"d62ea2ad57d0c4900c55d8fef87798a2\",\"kind\":\"distill\",\"state\":\"disposed\",\"payload\":{},\"created_at\":\"2026-09-07T12:00:00Z\",\"updated_at\":\"2026-09-07T12:00:00Z\",\"verdict\":\"accept\",\"actor\":\"tester\",\"disposed_at\":\"2026-09-07T12:00:00Z\",\"idempotency_key\":\"replay-key-1\"},\"replayed\":true}]}\n"
          }
        }
      ]
    },
    {
      "name": "dispose by group_id disposes every member individually, one result per member",
      "steps": [
        {
          "method": "POST",
          "path": "/disposition/dispose",
          "request_body": {
            "group_id": "g2",
            "verdict": "accept",
            "idempotency_key": "group-key-1"
          },
          "response": {
            "status": 200,
            "body": "{\"results\":[{\"item\":{\"id\":\"d0b3dcbfcff72383c9fe36cbf4c6f592\",\"kind\":\"decompose\",\"state\":\"disposed\",\"group_id\":\"g2\",\"payload\":{},\"created_at\":\"2026-09-07T12:00:00Z\",\"updated_at\":\"2026-09-07T12:00:00Z\",\"verdict\":\"accept\",\"disposed_at\":\"2026-09-07T12:00:00Z\",\"idempotency_key\":\"group-key-1\",\"ledger_effect_pending\":true}},{\"item\":{\"id\":\"bca12abeaf764b8df9068b27f9488288\",\"kind\":\"decompose\",\"state\":\"disposed\",\"group_id\":\"g2\",\"payload\":{},\"created_at\":\"2026-09-07T12:00:01Z\",\"updated_at\":\"2026-09-07T12:00:00Z\",\"verdict\":\"accept\",\"disposed_at\":\"2026-09-07T12:00:00Z\",\"idempotency_key\":\"group-key-1\",\"ledger_effect_pending\":true}}]}\n"
          }
        }
      ]
    },
    {
      "name": "dispose by an unknown group_id returns not_found",
      "steps": [
