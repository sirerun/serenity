{
  "protocol": "disposition",
  "operation": "dispose",
  "cases": [
    {
      "name": "dispose accept records the verdict",
      "steps": [
        {
          "method": "POST",
          "path": "/disposition/dispose",
          "request_body": {
            "item_id": "ebb90defc84c86a3010f076589d2e015",
            "verdict": "accept",
            "idempotency_key": "accept-key-1",
            "actor": "tester"
          },
          "response": {
            "status": 200,
            "body": "{\"results\":[{\"item\":{\"id\":\"ebb90defc84c86a3010f076589d2e015\",\"kind\":\"distill\",\"state\":\"disposed\",\"payload\":{},\"created_at\":\"2026-09-07T12:00:00Z\",\"updated_at\":\"2026-09-07T12:00:00Z\",\"verdict\":\"accept\",\"actor\":\"agent:daemon\",\"disposed_at\":\"2026-09-07T12:00:00Z\",\"idempotency_key\":\"accept-key-1\"}}]}\n"
          }
        }
      ]
    },
    {
      "name": "reject without a note returns the reject_requires_note protocol error",
      "steps": [
        {
          "method": "POST",
          "path": "/disposition/dispose",
          "request_body": {
            "item_id": "182ee55d8720eeb003eb159588543c6a",
            "verdict": "reject",
            "idempotency_key": "reject-key-1"
          },
          "response": {
            "status": 400,
            "body": "{\"error\":\"reject_requires_note\",\"message\":\"disposition: reject requires a note\"}\n"
          }
        }
      ]
    },
    {
      "name": "dispose without idempotency_key returns invalid_request",
      "steps": [
        {
          "method": "POST",
          "path": "/disposition/dispose",
          "request_body": {
            "item_id": "6690d5075e44b885db74e84a36e79c4e",
            "verdict": "accept",
            "idempotency_key": ""
          },
          "response": {
            "status": 400,
            "body": "{\"error\":\"invalid_request\",\"message\":\"idempotency_key is required\"}\n"
          }
        }
      ]
    },
    {
      "name": "replaying dispose with the same idempotency_key returns replayed:true, never a second write",
      "steps": [
        {
          "method": "POST",
          "path": "/disposition/dispose",
          "request_body": {
            "item_id": "4f16bcb1c055d15249b4a29781baf6eb",
            "verdict": "accept",
            "idempotency_key": "replay-key-1",
            "actor": "tester"
          },
          "response": {
            "status": 200,
            "body": "{\"results\":[{\"item\":{\"id\":\"4f16bcb1c055d15249b4a29781baf6eb\",\"kind\":\"distill\",\"state\":\"disposed\",\"payload\":{},\"created_at\":\"2026-09-07T12:00:00Z\",\"updated_at\":\"2026-09-07T12:00:00Z\",\"verdict\":\"accept\",\"actor\":\"agent:daemon\",\"disposed_at\":\"2026-09-07T12:00:00Z\",\"idempotency_key\":\"replay-key-1\"}}]}\n"
          }
        },
        {
          "method": "POST",
          "path": "/disposition/dispose",
          "request_body": {
            "item_id": "4f16bcb1c055d15249b4a29781baf6eb",
            "verdict": "accept",
            "idempotency_key": "replay-key-1",
            "actor": "tester"
          },
          "response": {
            "status": 200,
            "body": "{\"results\":[{\"item\":{\"id\":\"4f16bcb1c055d15249b4a29781baf6eb\",\"kind\":\"distill\",\"state\":\"disposed\",\"payload\":{},\"created_at\":\"2026-09-07T12:00:00Z\",\"updated_at\":\"2026-09-07T12:00:00Z\",\"verdict\":\"accept\",\"actor\":\"agent:daemon\",\"disposed_at\":\"2026-09-07T12:00:00Z\",\"idempotency_key\":\"replay-key-1\"},\"replayed\":true}]}\n"
          }
        }
      ]
    },
    {
      "name": "dispose by group_id disposes every member individually, one result per member",
      "steps": [
        {
          "method": "POST",
          "path": "/disposition/dispose",
          "request_body": {
            "group_id": "g2",
            "verdict": "accept",
            "idempotency_key": "group-key-1"
          },
          "response": {
            "status": 200,
            "body": "{\"results\":[{\"item\":{\"id\":\"9722261d0bafc283c115905f904bbf64\",\"kind\":\"distill\",\"state\":\"disposed\",\"group_id\":\"g2\",\"payload\":{},\"created_at\":\"2026-09-07T12:00:00Z\",\"updated_at\":\"2026-09-07T12:00:00Z\",\"verdict\":\"accept\",\"actor\":\"agent:daemon\",\"disposed_at\":\"2026-09-07T12:00:00Z\",\"idempotency_key\":\"group-key-1\"}},{\"item\":{\"id\":\"e8cbbee695f907cea3c5ab31cd9e0a07\",\"kind\":\"distill\",\"state\":\"disposed\",\"group_id\":\"g2\",\"payload\":{},\"created_at\":\"2026-09-07T12:00:01Z\",\"updated_at\":\"2026-09-07T12:00:00Z\",\"verdict\":\"accept\",\"actor\":\"agent:daemon\",\"disposed_at\":\"2026-09-07T12:00:00Z\",\"idempotency_key\":\"group-key-1\"}}]}\n"
          }
        }
      ]
    },
    {
      "name": "dispose by an unknown group_id returns not_found",
      "steps": [
        {
          "method": "POST",
          "path": "/disposition/dispose",
          "request_body": {
            "group_id": "no-such-group",
            "verdict": "accept",
            "idempotency_key": "group-key-2"
          },
          "response": {
            "status": 404,
            "body": "{\"error\":\"not_found\",\"message\":\"no items found for group_id no-such-group\"}\n"
          }
