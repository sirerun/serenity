{
  "protocol": "disposition",
  "operation": "capture",
  "cases": [
    {
      "name": "capture text stages a distill item and returns its id",
      "steps": [
        {
          "method": "POST",
          "path": "/disposition/capture",
          "request_body": {
            "text": "call the landlord about the lease"
          },
          "response": {
            "status": 200,
            "body": "{\"item_id\":\"80c458a6e790b2a820f0cb5263e5789e\"}\n"
          }
        }
      ]
    },
    {
      "name": "capture with no text and no audio_ref returns capture_empty",
      "steps": [
        {
          "method": "POST",
          "path": "/disposition/capture",
          "request_body": {},
          "response": {
            "status": 400,
            "body": "{\"error\":\"capture_empty\",\"message\":\"disposition: capture: text or audio_ref required\"}\n"
          }
        }
      ]
    }
  ]
}
